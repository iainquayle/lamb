(true -> false -> some -> none -> tuple_2 -> combinator ->
	(not -> and -> or -> xor -> elem -> foldl -> foldr ->
		(reverse -> map ->
			foldr xor true (elem true (elem false (elem true none)))
		)
		(foldl -> (acc -> value -> elem value acc) none)
		(foldl -> fn -> (acc -> value -> elem (fn value) acc) none)
	)
	(b -> b false true)
	(b1 -> b2 -> b1 b2 false) 
	(b1 -> b2 -> b1 true b2) 
	(b1 -> b2 -> b1 (b2 false true) b2) 
	(value -> next -> some (tuple_2 value next))
	(combinator (self -> fn -> acc -> list_head -> 
		list_head 
		(tuple_value_next -> tuple_value_next (
			value -> next -> (combinator self) fn (fn acc value) next
		)) 
		(acc)
	))
	(combinator (self -> fn -> acc -> list_head -> 
		list_head 
		(tuple_value_next -> tuple_value_next (
			value -> next -> fn ((combinator self) fn acc next) value
		)) 
		(acc)
	))
)
(t -> f -> t)
(t -> f -> f)
(value -> on_some -> on_none -> on_some value)
(on_some -> on_none -> on_none)
(v1 -> v2 -> fn -> fn v1 v2)
(x -> x x)
