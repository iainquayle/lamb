(true -> false -> 
	(not -> and -> or -> xor -> 
		(some -> none ->
			(elem ->
				(true)
			)
			(data -> next -> some (data -> next -> fn -> fn data next) data next)
		)
		(some -> some_fn -> none -> some_fn some)
		(some_fn -> none -> none)
	)
	(b -> b false true)
	(b1 -> b2 -> b1 b2 false) 
	(b1 -> b2 -> b1 true b2) 
	(b1 -> b2 -> b1 (b2 false true) b2) 
)
(t -> f -> t)
(t -> f -> f)
