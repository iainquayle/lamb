(true -> false -> some -> none -> tuple_2 -> combinator ->
	(not -> and -> or -> xor -> elem -> foldl -> foldr ->
		(reverse -> map ->
			foldl and true ( (elem true (elem true (elem true none))))
		)
		(list -> foldl (acc -> value -> elem value acc) none list)
		(fn -> list -> foldr (acc -> value -> elem (fn value) acc) none list)
	)
	(bool -> bool false true)
	(bool_1 -> bool_2 -> bool_1 bool_2 false) 
	(bool_1 -> bool_2 -> bool_1 true bool_2) 
	(bool_1 -> bool_2 -> bool_1 (bool_2 false true) bool_2) 
	(value -> next -> some (tuple_2 value next))
	(combinator (self_fold -> fn -> acc -> list_head -> 
		list_head 
		(tuple_value_next -> tuple_value_next (
			value -> next -> (combinator self_fold) fn (fn acc value) next
		)) 
		(acc)
	))
	(combinator (self_fold -> fn -> acc -> list_head -> 
		list_head 
		(tuple_value_next -> tuple_value_next (
			value -> next -> fn ((combinator self_fold) fn acc next) value
		)) 
		(acc)
	))
)
(true -> false -> true)
(true -> false -> false)
(value -> on_some -> on_none -> on_some value)
(on_some -> on_none -> on_none)
(value_1 -> value_2 -> fn -> fn value_1 value_2)
(x -> x x)
